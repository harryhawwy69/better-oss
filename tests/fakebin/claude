#!/bin/sh
# A fake Claude Code CLI for the test suite.
#
# check_voice.py and check_gate.py run `claude -p --model <model>` with the
# prompt on stdin and parse a fenced JSON verdict from stdout. This reads the
# prompt (so the pipe drains), ignores it, and prints a verdict chosen by the
# environment:
#
#   FAKE_CLAUDE_VERDICT   "pass" (default) or "stop"; stop without
#                         FAKE_CLAUDE_JSON has no rule, which is the
#                         "(rule not quoted)" branch
#   FAKE_CLAUDE_JSON     the whole verdict object, verbatim
#   FAKE_CLAUDE_EXIT     a non-zero exit, for the fail-closed path
#
# No model, no network, no credentials: the tests run where a developer has
# neither credits nor a login.
cat > /dev/null
if [ -n "${FAKE_CLAUDE_EXIT:-}" ]; then
  echo "fake claude: exiting ${FAKE_CLAUDE_EXIT} on purpose" >&2
  exit "$FAKE_CLAUDE_EXIT"
fi
# The pr-monitor reads the draft as plain text; the guards read a fenced JSON
# verdict. Which one a test needs is the variable it sets.
if [ -n "${FAKE_CLAUDE_TEXT:-}" ]; then
  printf '%s\n' "$FAKE_CLAUDE_TEXT"
elif [ -n "${FAKE_CLAUDE_JSON:-}" ]; then
  printf '```json\n%s\n```\n' "$FAKE_CLAUDE_JSON"
else
  printf '```json\n{"verdict": "%s"}\n```\n' "${FAKE_CLAUDE_VERDICT:-pass}"
fi
